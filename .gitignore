# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
next-env.d.ts

# env
.env
.env.*
!.env.example

# os / editor
.DS_Store
*.log

# third-party research captures (kept out of the public repo)
docs/research/legora/

# raw media downloads from older runs (the pipeline now caches under .next/cache)
media-src/

# typescript incremental build info
*.tsbuildinfo

# raw before/after capture sets (the compare sheets are committed)
docs/screenshots/before/
docs/screenshots/after/

# media written by scripts/media/fetch.mjs (the build fetches and encodes it); only the index is tracked
public/media/*
!public/media/index.json
